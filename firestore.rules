rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /subscribers/{subscriber} {
      allow create: if request.auth == null; // No auth needed
      allow read: if false; // Block public reads
    }

    match /demos/{demo} {
      allow create: if request.auth == null; // No auth needed
      allow read: if false; // Block public reads
    }
    
    match /businesses/{businessId} {
      // Anyone can signup and create their own business
      allow create: if true;
      
      // Allow read/write/update only to users associated with the business
      allow read, write, update: if request.auth.token.businessId == businessId;

      // Disallow deletes unless you implement business deletion logic
      allow delete: if false;

      match /chats/{chatId} {
        allow read, write, update, list: if request.auth.token.businessId == businessId 
          && request.auth.token.role == 'owner'
        allow delete: if false; // or your own logic
      }

      match /orders/{orderId} {
        allow create: if true; // Allow anyone to create orders
        allow read: if true;
      }
    }

    match /{document=**} {
      // Deny list on all collections by default
      allow list: if false;
    }
  }
}