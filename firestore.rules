rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /subscribers/{subscriber} {
      allow create: if request.auth == null; // No auth needed
      allow read: if false; // Block public reads
    }

    match /demos/{demo} {
      allow create: if request.auth == null; // No auth needed
      allow read: if false; // Block public reads
    }
    
    match /businesses/{businessId} {
      // Anyone can signup and create their own business
      allow create: if true;
      
      // Allow read for public access (needed for subdomain lookup)
      allow read: if true;
      
      // Allow list for public access (needed for subdomain lookup)
      allow list: if true;
      
      // Standard business updates for owners/admins
      allow write, update: if request.auth.token.businessId == businessId
        && request.auth.token.role in ['owner', 'admin'];

      // Restrict sensitive wallet field updates to owners with MFA + recent auth
      allow update: if request.auth.token.businessId == businessId
        && request.auth.token.role == 'owner'
        && request.auth.token.firebase.sign_in_second_factor != null
        && request.time.toMillis() - request.auth.token.auth_time * 1000 < 300000 // 5 minutes
        && (
          // Only allow wallet-related field updates with enhanced security
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['merchantWallet', 'walletUpdatedAt', 'walletUpdatedBy']))
          || 
          // OR allow other non-wallet updates with standard auth
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['merchantWallet']))
        );

      // Disallow deletes unless you implement business deletion logic
      allow delete: if false;

      match /menu/{menuId} {
        // Allow public read access to menu data
        allow read, list: if true;
        
        // Allow write/update only to business owners
        allow write, update: if request.auth.token.businessId == businessId;
        allow delete: if false;
        
        match /items/{itemId} {
          // Allow public read access to menu items
          allow read, list: if true;
          
          // Allow write/update only to business owners
          allow write, update: if request.auth.token.businessId == businessId;
          allow delete: if false;
        }
      }

      match /chats/{chatId} {
        allow read, write, update, list: if request.auth.token.businessId == businessId 
          && request.auth.token.role == 'owner'
        allow delete: if false; // or your own logic
      }

      match /orders/{orderId} {
        allow create: if true; // Allow anyone to create orders
        allow read: if true;
      }
    }

    match /{document=**} {
      // Deny list on all collections by default
      allow list: if false;
    }
  }
}